# Frontend-safe values only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Twonara V1 opens Google Maps directions with a normal Maps URL,
# so no Google Maps API key is required for the first launch.

# Never put PAYHERE_MERCHANT_SECRET here or in any VITE_* variable.
# PayHere secrets belong only in Supabase Edge Function secrets.
