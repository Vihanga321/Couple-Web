# Frontend-safe values only
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Legacy projects can still use VITE_SUPABASE_ANON_KEY temporarily,
# but new Supabase projects should use the publishable key above.

# Twonara V1 opens Google Maps directions with a normal Maps URL,
# so no Google Maps API key is required for the first launch.

# Never put a Supabase secret/service-role key or PAYHERE_MERCHANT_SECRET
# here or in any VITE_* variable. Server secrets belong only in backend
# environments such as Supabase Edge Function secrets.
